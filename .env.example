PORT=3000
NODE_ENV=production
APP_BASE_URL=https://stravamap-production-7f28.up.railway.app
STRAVA_REDIRECT_URI=https://stravamap-production-7f28.up.railway.app/api/strava/callback
PRIMARY_STRAVA_CLIENT_ID=replace-with-connor-client-id
PRIMARY_STRAVA_CLIENT_SECRET=replace-with-connor-client-secret
MONGODB_URI=replace-with-mongodb-connection-string
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-with-random-webhook-verify-token

# Rollout switch for cursor-paginated lightweight activity lists. Leave false
# through the copy migration, then set true after the compatible frontend is live.
ACTIVITY_LIST_V2_ENABLED=false

# Intervals.icu personal API-key onboarding
PROVIDER_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OWNER_SESSION_SECRET=replace-with-at-least-32-random-characters
INTERVALS_SYNC_OLDEST=1970-01-01

# Optional legacy Connor-only OAuth rollout control. Personal API-key onboarding
# uses stored provider connections and does not require per-slug allowlisting.
# INTERVALS_ENABLED_SLUGS=connor

# Optional maximum accepted Strava export ZIP size in bytes. Defaults to 1 GiB.
# STRAVA_EXPORT_MAX_ZIP_BYTES=1073741824

# Optional administrative provisioning fallback. Set these only long enough to
# run `npm run provision:intervals-api-key`, then remove them from Railway.
# INTERVALS_SETUP_SLUG=connor
# INTERVALS_SETUP_ATHLETE_ID=replace-with-intervals-athlete-id
# INTERVALS_SETUP_API_KEY=replace-with-personal-api-key

# Optional future OAuth/webhook configuration. Not required for API-key onboarding.
# INTERVALS_CLIENT_ID=replace-with-intervals-client-id
# INTERVALS_CLIENT_SECRET=replace-with-intervals-client-secret
# INTERVALS_REDIRECT_URI=https://stravamap-production-7f28.up.railway.app/api/intervals/callback
# INTERVALS_CONNOR_ATHLETE_ID=replace-with-connor-intervals-athlete-id
# INTERVALS_WEBHOOK_SECRET=replace-with-random-webhook-secret

# Optional. The current Netlify map origin is already allowed by default.
FRONTEND_BASE_URL=https://fluffy-druid-f9a1d0.netlify.app
